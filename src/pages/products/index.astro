---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import EmailSignup from "../../components/EmailSignup.astro";
import { CONCERNS } from "../../consts";

const products = (await getCollection("products")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Base
	title="Shop the range"
	description="All four BioAnnova toothpastes — bamboo charcoal whitening, sensitivity relief, daily care, and anti-cavity protection. Filter by concern."
>
	<section class="shop-hero">
		<div class="container">
			<span class="eyebrow eyebrow--mute reveal">The Range</span>
			<h1 class="reveal">Four toothpastes. Pick your concern.</h1>

			<div class="filter-tabs reveal" role="tablist" aria-label="Filter by concern">
				<button data-filter="all" class="tab is-active" role="tab" aria-selected="true">All</button>
				{CONCERNS.map((c) => (
					<button data-filter={c.slug} class="tab" role="tab" aria-selected="false">{c.label}</button>
				))}
			</div>
		</div>
	</section>

	<section class="section section--top-tight">
		<div class="container">
			<div class="shop-grid" data-shop-grid>
				{products.map((p) => (
					<div class="shop-card" data-concern={p.data.concern}>
						<ProductCard product={p} />
					</div>
				))}
			</div>
		</div>
	</section>

	<EmailSignup />
</Base>

<style>
	.shop-hero { padding: var(--sp-20) 0 var(--sp-12); background: var(--c-cream); }
	.shop-hero h1 { font-size: var(--fs-3xl); margin: var(--sp-4) 0 var(--sp-8); max-width: 22ch; }

	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		padding-top: var(--sp-4);
		border-top: 1px solid var(--c-line);
	}
	.tab {
		padding: 0.55rem 1.1rem;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 500;
		border: 1px solid var(--c-line);
		background: transparent;
		color: var(--c-ink-soft);
		transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
	}
	.tab:hover { border-color: var(--c-forest); color: var(--c-forest); }
	.tab.is-active { background: var(--c-forest); color: var(--c-bone); border-color: var(--c-forest); }

	.section--top-tight { padding-top: var(--sp-12); }
	.shop-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-12);
	}
	@media (min-width: 680px) { .shop-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (min-width: 1100px) { .shop-grid { grid-template-columns: repeat(4, 1fr); gap: var(--sp-8); } }

	.shop-card[hidden] { display: none; }
</style>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
	const cards = document.querySelectorAll<HTMLElement>("[data-concern]");
	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			const filter = tab.dataset.filter;
			tabs.forEach((t) => {
				t.classList.toggle("is-active", t === tab);
				t.setAttribute("aria-selected", String(t === tab));
			});
			cards.forEach((card) => {
				const match = filter === "all" || card.dataset.concern === filter;
				card.hidden = !match;
			});
		});
	});
</script>
