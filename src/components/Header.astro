---
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import { CONCERNS } from "../consts";
import logo from "../assets/logo.png";
---

<header class="site-header">
	<div class="container header-inner">
		<a href="/" class="brand" aria-label="BioAnnova home">
			<Image
				src={logo}
				alt="BioAnnova"
				widths={[160, 240, 320, 480]}
				sizes="160px"
				quality={92}
				loading="eager"
				class="brand-logo"
			/>
		</a>

		<nav class="nav-desktop" aria-label="Primary">
			<HeaderLink href="/products">Shop</HeaderLink>
			<div class="dropdown">
				<button class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">
					Concerns
					<svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
						<path d="M1 1l4 4 4-4" stroke="currentColor" fill="none" stroke-width="1.2" />
					</svg>
				</button>
				<div class="dropdown-menu" role="menu">
					{CONCERNS.map((c) => (
						<a href={`/products/${c.productSlug}`} role="menuitem">{c.label}</a>
					))}
				</div>
			</div>
			<HeaderLink href="/science">Science</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</nav>

		<div class="header-actions">
			<button class="cart-btn" aria-label="Cart (0 items)" type="button">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M3 6h2l2 12h11l2-8H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
					<circle cx="9" cy="20" r="1.3" fill="currentColor"/>
					<circle cx="17" cy="20" r="1.3" fill="currentColor"/>
				</svg>
				<span class="cart-count" aria-hidden="true">0</span>
			</button>
			<button class="menu-btn" aria-label="Menu" aria-expanded="false" type="button">
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>

	<nav class="nav-mobile" aria-label="Mobile" data-mobile-nav>
		<a href="/products">Shop</a>
		{CONCERNS.map((c) => (
			<a href={`/products/${c.productSlug}`}>{c.label}</a>
		))}
		<a href="/science">Science</a>
		<a href="/about">About</a>
		<a href="/contact">Contact</a>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(248, 246, 241, 0.92);
		backdrop-filter: saturate(180%) blur(10px);
		-webkit-backdrop-filter: saturate(180%) blur(10px);
		border-bottom: 1px solid var(--c-line);
	}
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-6);
		height: var(--header-h);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.brand :global(.brand-logo) {
		display: block;
		height: clamp(36px, 4.5vw, 48px);
		width: auto;
	}

	.nav-desktop {
		display: none;
		align-items: center;
		gap: var(--sp-8);
	}
	@media (min-width: 980px) {
		.nav-desktop { display: flex; }
	}

	.dropdown { position: relative; }
	.dropdown-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-weight: 500;
		color: var(--c-ink);
		padding: 0.5rem 0;
		cursor: pointer;
	}
	.dropdown-trigger:hover { color: var(--c-forest); }
	.dropdown-menu {
		position: absolute;
		top: calc(100% + 4px);
		left: 50%;
		transform: translateX(-50%) translateY(4px);
		min-width: 200px;
		background: var(--c-bone);
		border: 1px solid var(--c-line);
		padding: 0.5rem 0;
		opacity: 0;
		visibility: hidden;
		transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
		box-shadow: var(--shadow-soft);
	}
	.dropdown:hover .dropdown-menu,
	.dropdown:focus-within .dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
	}
	.dropdown-menu a {
		display: block;
		padding: 0.65rem 1.25rem;
		font-size: 0.85rem;
		color: var(--c-ink-soft);
		transition: background 150ms ease, color 150ms ease;
	}
	.dropdown-menu a:hover {
		background: var(--c-bone-warm);
		color: var(--c-forest);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: var(--sp-3);
	}
	.cart-btn {
		position: relative;
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		color: var(--c-ink);
		border-radius: 50%;
		transition: background 200ms ease;
	}
	.cart-btn:hover { background: var(--c-bone-warm); }
	.cart-count {
		position: absolute;
		top: 4px;
		right: 4px;
		font-size: 0.6rem;
		min-width: 16px;
		height: 16px;
		padding: 0 4px;
		background: var(--c-forest);
		color: var(--c-bone);
		border-radius: 999px;
		display: grid;
		place-items: center;
		font-weight: 500;
	}

	.menu-btn {
		display: grid;
		gap: 5px;
		padding: 10px 8px;
	}
	.menu-btn span {
		display: block;
		width: 22px;
		height: 1px;
		background: var(--c-ink);
	}
	@media (min-width: 980px) {
		.menu-btn { display: none; }
	}

	.nav-mobile {
		display: none;
		flex-direction: column;
		padding: var(--sp-4) var(--sp-6) var(--sp-8);
		border-top: 1px solid var(--c-line);
	}
	.nav-mobile a {
		padding: var(--sp-3) 0;
		font-size: 0.85rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 500;
		border-bottom: 1px solid var(--c-line);
	}
	.nav-mobile.open { display: flex; }
</style>

<script>
	const menuBtn = document.querySelector<HTMLButtonElement>(".menu-btn");
	const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");
	menuBtn?.addEventListener("click", () => {
		const isOpen = mobileNav?.classList.toggle("open");
		menuBtn.setAttribute("aria-expanded", String(Boolean(isOpen)));
	});
</script>
