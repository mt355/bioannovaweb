---
import { Image } from "astro:assets";

const productImages = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/products/*.jpg",
	{ eager: true },
);

interface Props {
	file: string;
	alt: string;
	width: number;
	height?: number;
	loading?: "eager" | "lazy";
	sizes?: string;
	class?: string;
}

const { file, alt, width, height, loading = "lazy", sizes, class: className } = Astro.props;

const key = `../assets/products/${file}`;
const mod = productImages[key];
if (!mod) {
	throw new Error(`Product image not found: ${file}`);
}

const intrinsicWidth = mod.default.width;
const candidateWidths = [width, width * 1.5, width * 2, width * 3]
	.map((w) => Math.round(w))
	.filter((w) => w <= intrinsicWidth);
const widths = candidateWidths.length > 0 ? candidateWidths : [Math.min(width, intrinsicWidth)];
---

<Image
	src={mod.default}
	alt={alt}
	width={width}
	height={height}
	widths={widths}
	loading={loading}
	sizes={sizes}
	formats={["avif", "webp"]}
	quality={88}
	class={className}
/>
