---
import ProductImage from "./ProductImage.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
	product: CollectionEntry<"products">;
	priority?: boolean;
}
const { product, priority = false } = Astro.props;
const p = product.data;
const formatted = new Intl.NumberFormat("en-GB", {
	style: "currency",
	currency: p.currency,
}).format(p.price);
---

<a href={`/products/${product.id}`} class="card reveal">
	<div class="card-media">
		<ProductImage
			file={p.heroImage}
			alt={p.name}
			width={800}
			height={1000}
			loading={priority ? "eager" : "lazy"}
			sizes="(min-width: 1100px) 28vw, (min-width: 700px) 45vw, 90vw"
		/>
		<span class="concern-tag">{p.concernLabel}</span>
	</div>
	<div class="card-body">
		<h3 class="card-name">{p.name}</h3>
		<p class="card-tagline">{p.tagline}</p>
		<div class="card-foot">
			<span class="card-price">{formatted}</span>
			<span class="card-cta">Shop —</span>
		</div>
	</div>
</a>

<style>
	.card {
		display: block;
		color: inherit;
		text-decoration: none;
		transition: transform 400ms ease;
	}
	.card:hover { transform: translateY(-4px); }

	.card-media {
		position: relative;
		aspect-ratio: 4 / 5;
		background: var(--c-bone-warm);
		overflow: hidden;
		margin-bottom: var(--sp-6);
	}
	.card-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 800ms cubic-bezier(0.2, 0.65, 0.2, 1);
	}
	.card:hover .card-media :global(img) { transform: scale(1.04); }

	.concern-tag {
		position: absolute;
		top: var(--sp-4);
		left: var(--sp-4);
		background: rgba(248, 246, 241, 0.92);
		color: var(--c-forest);
		padding: 0.4rem 0.8rem;
		font-size: 0.65rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-weight: 500;
	}

	.card-name {
		font-family: var(--ff-serif);
		font-size: 1.4rem;
		line-height: 1.2;
		margin: 0 0 var(--sp-2);
		letter-spacing: -0.01em;
	}
	.card-tagline {
		font-family: var(--ff-serif);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--c-ink-mute);
		margin: 0 0 var(--sp-4);
	}
	.card-foot {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-top: var(--sp-3);
		border-top: 1px solid var(--c-line);
	}
	.card-price {
		font-family: var(--ff-serif);
		font-size: 1.1rem;
	}
	.card-cta {
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-weight: 500;
		color: var(--c-forest);
		transition: letter-spacing 200ms ease;
	}
	.card:hover .card-cta { letter-spacing: 0.24em; }
</style>
