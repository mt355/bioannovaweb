---
import ProductImage from "./ProductImage.astro";

/*
 * Tagline (lead): "Clean oral care, naturally formulated."
 * Alternatives:
 *   • "The dentist-aligned standard for clean ingredients."
 *   • "Oral care, reformulated for the people who read labels."
 */
---

<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy reveal">
			<span class="eyebrow">A Herbapharmedica brand · est. 2012</span>
			<h1>
				Clean oral care,<br />
				<em>naturally formulated.</em>
			</h1>
			<p class="lede">
				Dentist-aligned toothpaste, made with the ingredients you'd choose
				yourself — and none of the ones you wouldn't.
			</p>
			<div class="hero-actions">
				<a href="/products" class="btn btn--primary">Shop the range</a>
				<a href="/science" class="btn btn--ghost">Read the science →</a>
			</div>
			<dl class="hero-stats">
				<div><dt>4</dt><dd>Targeted formulas</dd></div>
				<div><dt>0</dt><dd>SLS · parabens · dyes</dd></div>
				<div><dt>13+</dt><dd>Years of FMCG expertise</dd></div>
			</dl>
		</div>

		<div class="hero-media reveal">
			<div class="hero-frame">
				<ProductImage
					file="1-2.jpg"
					alt="Bio Annova Bamboo Charcoal Toothpaste"
					width={900}
					height={1200}
					loading="eager"
					sizes="(min-width: 1100px) 45vw, 90vw"
				/>
			</div>
			<p class="hero-caption">
				No. 01 — <em>Bamboo Charcoal</em>, our whitening edition
			</p>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: var(--sp-12) 0 var(--sp-24);
		background: linear-gradient(180deg, var(--c-bone) 0%, var(--c-bone-warm) 100%);
		overflow: hidden;
	}
	@media (min-width: 980px) {
		.hero { padding: var(--sp-20) 0 var(--sp-32); }
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-16);
		align-items: center;
	}
	@media (min-width: 980px) {
		.hero-grid { grid-template-columns: 1.05fr 0.95fr; gap: var(--sp-20); }
	}

	.hero-copy h1 {
		font-size: var(--fs-4xl);
		font-weight: 300;
		margin-bottom: var(--sp-6);
	}
	.hero-copy h1 em {
		font-style: italic;
		color: var(--c-forest);
		font-weight: 400;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-4);
		margin-top: var(--sp-8);
	}

	.hero-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--sp-4);
		margin: var(--sp-16) 0 0;
		padding-top: var(--sp-8);
		border-top: 1px solid var(--c-line);
	}
	.hero-stats div { margin: 0; }
	.hero-stats dt {
		font-family: var(--ff-serif);
		font-size: 2.5rem;
		color: var(--c-forest);
		line-height: 1;
		margin-bottom: var(--sp-2);
	}
	.hero-stats dd {
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--c-ink-mute);
	}

	.hero-media { position: relative; }
	.hero-frame {
		aspect-ratio: 3 / 4;
		background: var(--c-cream);
		position: relative;
		overflow: hidden;
	}
	.hero-frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero-caption {
		font-family: var(--ff-serif);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--c-ink-mute);
		margin: var(--sp-4) 0 0;
		text-align: right;
	}
</style>
